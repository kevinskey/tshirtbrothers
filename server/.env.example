DB_PASSWORD=
JWT_SECRET=
SS_ACCOUNT_NUMBER=
SS_API_KEY=
OPENAI_API_KEY=
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=tshirtbrothers
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
REMOVEBG_API_KEY=
DOMAIN=https://tshirtbrothers.com
RESEND_API_KEY=
FROM_EMAIL=noreply@tshirtbrothers.com
ADMIN_EMAIL=kevin@tshirtbrothers.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADMIN_PHONE=
# Google Places API — homepage Google reviews block + aggregateRating JSON-LD
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EASYPOST_API_KEY=
# GleeWorld integration — service-to-service provisioning + SSO handoff.
# Shared secrets: rotate on both sides simultaneously.
GLEEWORLD_SERVICE_KEY=
GLEEWORLD_SSO_SECRET=
# All Print Club (allprintclub.com) — 4over trade-printer API.
# Keys issued by 4over after signing their API agreement; verify with
# `node --env-file=.env scripts/fourover-smoke.mjs`. APC_DOMAIN switches the
# Stripe return URLs from tshirtbrothers.com/print-club to the real host.
FOUROVER_PUBLIC_KEY=
FOUROVER_PRIVATE_KEY=
APC_DOMAIN=https://allprintclub.com

# Live Hard Truth (livehardtruth.com) — sister-brand storefront on the
# store-shop system. Commerce URLs come from the client, so only needed if
# server-side LHT links are ever generated.
LHT_DOMAIN=https://livehardtruth.com
